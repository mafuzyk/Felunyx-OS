#!/usr/bin/env bash
set -Eeuo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source "$ROOT/tools/lib/common.sh"
source "$ROOT/tools/lib/mount_guard.sh"
source "$ROOT/tools/lib/build_user.sh"
usage(){ echo "usage: ${0##*/} --mode integration|frozen --output DIR [--archive-date YYYY/MM/DD] [--keep-work] [--dry-run]"; }
mode= output= archive_date= keep_work=false dry_run=false
while (($#)); do case $1 in --mode) mode=${2:-}; shift 2;; --output) output=${2:-}; shift 2;; --archive-date) archive_date=${2:-}; shift 2;; --keep-work) keep_work=true; shift;; --dry-run) dry_run=true; shift;; -h|--help) usage; exit 0;; *) usage >&2; exit 64;; esac; done
[[ $mode == integration || $mode == frozen ]] || felunyx_die 'mode must be integration or frozen'
[[ -n $output ]] || felunyx_die 'output is required'
if [[ $mode == frozen ]]; then [[ $archive_date =~ ^[0-9]{4}/[0-9]{2}/[0-9]{2}$ ]] || felunyx_die 'frozen mode requires --archive-date YYYY/MM/DD'; fi
repo_root=$(felunyx_realpath "$ROOT"); tmp_root=$(felunyx_realpath "${FELUNYX_TMP_ROOT:-${TMPDIR:-/tmp}/felunyx}"); mkdir -p "$tmp_root"
work=$(mktemp -d "$tmp_root/build.XXXXXXXX"); work=$(felunyx_assert_safe_workdir "$work" "$tmp_root" "$repo_root")
profile="$work/profile"; repo="$work/repo"; out="$work/out"; stage="$work/publish"; mkdir -p "$profile" "$repo" "$out" "$stage"; cp -a "$ROOT/iso/profile/." "$profile/"
cleanup(){ local rc=$?; if [[ $keep_work == true || $rc -ne 0 ]]; then felunyx_log "work directory retained: $work"; else felunyx_remove_workdir "$work" "$tmp_root" "$repo_root"; fi; exit "$rc"; }
trap cleanup EXIT INT TERM
if [[ $mode == frozen ]]; then mirror="https://archive.archlinux.org/repos/${archive_date}/\$repo/os/\$arch"; else mirror='https://geo.mirror.pkgbuild.com/$repo/os/$arch'; archive_date=current; fi
repo_uri="file://$repo"
bootstrap_pacman_conf="$work/pacman-bootstrap.conf"
pacman_wrapper="$work/felunyx-pacman"
python3 - "$profile/pacman.conf" "$repo_uri" "$mirror" "$bootstrap_pacman_conf" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]); text=p.read_text(); assert text.count('@FELUNYX_REPO_URI@') == 1
resolved=text.replace('@FELUNYX_REPO_URI@',sys.argv[2]).replace('Include = /etc/pacman.d/mirrorlist',f'Server = {sys.argv[3]}')
p.write_text(resolved)
bootstrap=[]; skipping=False
for line in resolved.splitlines(keepends=True):
    section=line.strip()
    if section == '[felunyx]':
        skipping=True
        continue
    if skipping and section.startswith('[') and section.endswith(']'):
        skipping=False
    if not skipping:
        bootstrap.append(line)
Path(sys.argv[4]).write_text(''.join(bootstrap))
PY
mkdir -p "$profile/airootfs/etc/pacman.d"; printf 'Server = %s\n' "$mirror" > "$profile/airootfs/etc/pacman.d/mirrorlist"
commit=$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || printf unknown); epoch=${SOURCE_DATE_EPOCH:-$(git -C "$ROOT" show -s --format=%ct HEAD 2>/dev/null || date +%s)}
export SOURCE_DATE_EPOCH=$epoch FELUNYX_SOURCE_COMMIT=$commit FELUNYX_ARCHIVE_DATE=$archive_date
python3 - "$stage/build-plan.json" "$mode" "$archive_date" "$commit" "$epoch" "$work" "$repo_uri" <<'PY'
import json,sys
keys=('mode','archive_date','commit','source_date_epoch','work_directory','repository_uri'); vals=sys.argv[2:]
with open(sys.argv[1],'w') as f: json.dump(dict(zip(keys,vals)),f,indent=2,sort_keys=True); f.write('\n')
PY
if [[ $dry_run == true ]]; then mkdir -p "$output"; cp "$stage/build-plan.json" "$output/"; keep_work=false; exit 0; fi
[[ $(id -u) -eq 0 ]] || felunyx_die 'full ISO build must run as root inside the canonical environment'
for cmd in mkarchiso makepkg repo-add runuser pacman python3 sha256sum gpg jq; do felunyx_require_command "$cmd"; done
"$ROOT/tools/felunyx-preflight" --json "$stage/preflight.json"
builder=felunyx-builder; if ! id "$builder" >/dev/null 2>&1; then useradd --create-home --shell /bin/bash "$builder"; fi
install -d -o "$builder" -g "$builder" "$work/pkgwork" "$repo"
build_package(){
  local src="$ROOT/packages/$1" dst="$work/pkgwork/$1"
  cp -a "$src" "$dst"
  chown -R "$builder:$builder" "$dst"
  runuser -u "$builder" -- env PACMAN="$pacman_wrapper" SOURCE_DATE_EPOCH="$epoch" FELUNYX_SOURCE_COMMIT="$commit" FELUNYX_ARCHIVE_DATE="$archive_date" bash -lc "cd '$dst' && makepkg --syncdeps --noconfirm --cleanbuild --clean"
  find "$dst" -maxdepth 1 -type f -name '*.pkg.tar.*' ! -name '*.sig' -exec cp -t "$repo" {} +
  repo-add "$repo/felunyx.db.tar.zst" "$repo"/*.pkg.tar.*
  "$pacman_wrapper" --sync --refresh --noconfirm
}
environment_lock="$ROOT/build/environment.lock.json"
release_certificate_path=$(jq -er '.calamares.release_certificate_path' "$environment_lock")
release_certificate_sha256=$(jq -er '.calamares.release_certificate_sha256' "$environment_lock")
release_primary_fingerprint=$(jq -er '.calamares.primary_key_fingerprint' "$environment_lock")
release_subkey_fingerprint=$(jq -er '.calamares.signing_subkey_fingerprint' "$environment_lock")
case "$release_certificate_path" in
  /*|../*|*/../*|*/..) felunyx_die 'Calamares release certificate path must remain inside the repository';;
esac
key_source="$ROOT/$release_certificate_path"
[[ -f $key_source ]] || felunyx_die 'vendored Calamares release certificate is missing'
printf '%s  %s\n' "$release_certificate_sha256" "$key_source" | sha256sum --check --strict
key_bundle="$work/calamares-release-key.asc"
install -m 0644 "$key_source" "$key_bundle"
chown "$builder:$(id -g "$builder")" "$key_bundle"
export GNUPGHOME="$work/gnupg"
felunyx_prepare_builder_private_dir "$work" "$GNUPGHOME" "$builder" "$(id -g "$builder")"
printf '%s\n' \
  '#!/usr/bin/env bash' \
  'set -Eeuo pipefail' \
  "if [[ -e '$repo/felunyx.db' ]]; then" \
  "  pacman_config='$profile/pacman.conf'" \
  'else' \
  "  pacman_config='$bootstrap_pacman_conf'" \
  'fi' \
  'exec /usr/bin/pacman --config "$pacman_config" "$@"' > "$pacman_wrapper"
chmod 0755 "$pacman_wrapper"
echo "$builder ALL=(root) NOPASSWD: $pacman_wrapper" > /etc/sudoers.d/felunyx-builder
chmod 0440 /etc/sudoers.d/felunyx-builder
"$pacman_wrapper" --sync --refresh --noconfirm
runuser -u "$builder" -- gpg --batch --import-options import-minimal --import "$key_bundle"
mapfile -t release_fingerprints < <(runuser -u "$builder" -- gpg --batch --with-colons --with-subkey-fingerprint --list-keys "$release_primary_fingerprint" | awk -F: '$1=="fpr" {print $10}')
printf '%s\n' "${release_fingerprints[@]}" | grep -Fxq "$release_primary_fingerprint" || felunyx_die 'Calamares release primary-key fingerprint mismatch'
printf '%s\n' "${release_fingerprints[@]}" | grep -Fxq "$release_subkey_fingerprint" || felunyx_die 'Calamares release signing subkey is absent from the signer certificate'
uid_count=$(runuser -u "$builder" -- gpg --batch --with-colons --list-keys "$release_primary_fingerprint" | awk -F: '$1=="uid" {count++} END {print count+0}')
(( uid_count > 0 )) || felunyx_die 'Calamares release certificate has no usable user identity'
key_sha256=$(sha256sum "$key_bundle" | awk '{print $1}')
[[ $key_sha256 == "$release_certificate_sha256" ]] || felunyx_die 'copied Calamares release certificate hash mismatch'
python3 - "$stage/calamares-release-key.json" "$release_certificate_path" "$key_sha256" "$release_primary_fingerprint" "$release_subkey_fingerprint" "$uid_count" "${release_fingerprints[*]}" <<'PY'
import json,sys
with open(sys.argv[1],'w') as f:
 json.dump({"schema":1,"source":sys.argv[2],"bundle_sha256":sys.argv[3],"primary_key_fingerprint":sys.argv[4],"required_signing_subkey_fingerprint":sys.argv[5],"uid_count":int(sys.argv[6]),"certificate_fingerprints":sys.argv[7].split()},f,indent=2,sort_keys=True); f.write('\n')
PY
for pkg in calamares felunyx-identity felunyx-iso-hooks felunyx-calamares-config; do build_package "$pkg"; done
"$pacman_wrapper" --files --refresh --noconfirm
"$ROOT/tools/felunyx-validate" --profile "$profile" --report "$stage/profile-validation.json"
exec > >(tee "$work/build.log") 2>&1; mkarchiso -v -w "$work/archiso" -o "$out" "$profile"
iso=$(find "$out" -maxdepth 1 -type f -name '*.iso' -print -quit); [[ -n $iso ]] || felunyx_die 'mkarchiso completed without an ISO artifact'
cp "$iso" "$stage/Felunyx-OS-phase2-${commit:0:12}-x86_64.iso"; cp "$work/build.log" "$stage/build.log"
manifest=$(find "$work/archiso/iso" -maxdepth 3 -type f -name 'pkglist.*.txt' -print -quit)
if [[ -n $manifest ]]; then
  cp "$manifest" "$stage/packages.txt"
else
  cp "$profile/packages.x86_64" "$stage/packages.txt"
fi
python3 - "$stage/build-info.json" "$mode" "$archive_date" "$commit" "$epoch" <<'PY'
import json,sys
with open(sys.argv[1],'w') as f: json.dump({"schema":1,"phase":2,"mode":sys.argv[2],"archive_date":sys.argv[3],"source_commit":sys.argv[4],"source_date_epoch":int(sys.argv[5]),"archiso":"89-1"},f,indent=2,sort_keys=True); f.write('\n')
PY
python3 - "$ROOT/build/environment.lock.json" "$ROOT/iso/upstream/releng.lock.json" "$stage/source-lock.json" <<'PY'
import json,sys
with open(sys.argv[3],'w') as f: json.dump({"environment":json.load(open(sys.argv[1])),"releng":json.load(open(sys.argv[2]))},f,indent=2,sort_keys=True); f.write('\n')
PY
"$ROOT/tools/felunyx-validate" --profile "$profile" --iso "$stage"/*.iso --report "$stage/validation-report.json"
(cd "$stage" && sha256sum *.iso build-info.json calamares-release-key.json packages.txt source-lock.json validation-report.json > SHA256SUMS)
output=$(felunyx_realpath "$output"); publish_tmp="${output}.new.$$"; rm -rf -- "$publish_tmp"; mkdir -p -- "$publish_tmp"; cp -a "$stage/." "$publish_tmp/"; rm -rf -- "$output"; mv -- "$publish_tmp" "$output"
