#!/usr/bin/env python3
"""Emit read-only evidence from an installed Felunyx system."""
from __future__ import annotations

import json
import os
import re
import subprocess
import tempfile
from pathlib import Path

LIVE_MARKER = Path("/run/felunyx/live")
FW_CFG_MARKER = Path(
    "/sys/firmware/qemu_fw_cfg/by_name/opt/felunyx/evidence/raw"
)
BUILD_INFO = Path("/usr/lib/felunyx/build-info.json")
OUTPUT = Path("/run/felunyx/installed-evidence.json")
EXPECTED_TARGETS = (
    "/",
    "/home",
    "/.snapshots",
    "/var/cache",
    "/var/log",
    "/boot/efi",
)


def enabled() -> bool:
    try:
        command_line = Path("/proc/cmdline").read_text(
            encoding="utf-8", errors="ignore"
        )
    except OSError:
        command_line = ""
    if "felunyx.evidence=1" in command_line:
        return True
    try:
        return (
            FW_CFG_MARKER.exists()
            and FW_CFG_MARKER.read_bytes().rstrip(b"\0\n") == b"1"
        )
    except OSError:
        return False


def run(command: list[str]) -> dict[str, object]:
    completed = subprocess.run(
        command,
        check=False,
        text=True,
        capture_output=True,
    )
    return {
        "command": command,
        "returncode": completed.returncode,
        "stdout": completed.stdout,
        "stderr": completed.stderr,
    }


def active(unit: str) -> bool:
    return run(["systemctl", "is-active", "--quiet", unit])["returncode"] == 0


def package_present(name: str) -> bool:
    return run(["pacman", "-Q", name])["returncode"] == 0


def read_os_release() -> dict[str, str]:
    values: dict[str, str] = {}
    try:
        lines = Path("/usr/lib/os-release").read_text(
            encoding="utf-8"
        ).splitlines()
    except OSError:
        return values
    for line in lines:
        if "=" not in line or line.startswith("#"):
            continue
        key, value = line.split("=", 1)
        values[key] = value.strip().strip('"')
    return values


def read_build_info() -> tuple[bool, dict[str, object]]:
    try:
        data = json.loads(BUILD_INFO.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return False, {}
    if not isinstance(data, dict):
        return False, {}
    return True, data


def split_options(value: str) -> list[str]:
    return sorted({item.strip() for item in value.split(",") if item.strip()})


def normalize_subvolume(value: str | None) -> str | None:
    if not value:
        return None
    return "/" + value.strip().lstrip("/")


def subvolume_from(source: str, option_list: list[str]) -> str | None:
    for option in option_list:
        if option.startswith("subvol="):
            return normalize_subvolume(option.split("=", 1)[1])
    match = re.search(r"\[([^]]+)\]$", source)
    return normalize_subvolume(match.group(1)) if match else None


def find_mount(target: str) -> dict[str, object]:
    observed = run(
        [
            "findmnt",
            "--json",
            "--output",
            "TARGET,SOURCE,FSTYPE,OPTIONS",
            "--target",
            target,
        ]
    )
    if observed["returncode"] != 0:
        return {
            "source": "",
            "fstype": "",
            "options": [],
            "subvolume": None,
        }
    try:
        document = json.loads(str(observed["stdout"]))
        filesystems = document.get("filesystems", [])
        item = filesystems[0] if filesystems else {}
    except (json.JSONDecodeError, AttributeError, IndexError):
        item = {}
    source = str(item.get("source", ""))
    option_list = split_options(str(item.get("options", "")))
    return {
        "source": source,
        "fstype": str(item.get("fstype", "")),
        "options": option_list,
        "subvolume": subvolume_from(source, option_list),
    }


def btrfs_subvolumes() -> list[str]:
    observed = run(["btrfs", "subvolume", "list", "/"])
    if observed["returncode"] != 0:
        return []
    result: set[str] = set()
    for line in str(observed["stdout"]).splitlines():
        match = re.search(r"\spath\s+(.+)$", line)
        if match:
            normalized = normalize_subvolume(match.group(1))
            if normalized:
                result.add(normalized)
    return sorted(result)


def decode_fstab_field(value: str) -> str:
    replacements = {
        "\\040": " ",
        "\\011": "\t",
        "\\012": "\n",
        "\\134": "\\",
    }
    for encoded, decoded in replacements.items():
        value = value.replace(encoded, decoded)
    return value


def read_fstab() -> list[dict[str, object]]:
    try:
        lines = Path("/etc/fstab").read_text(
            encoding="utf-8", errors="replace"
        ).splitlines()
    except OSError:
        return []
    result: list[dict[str, object]] = []
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        fields = stripped.split()
        if len(fields) < 4:
            continue
        result.append(
            {
                "source": decode_fstab_field(fields[0]),
                "target": decode_fstab_field(fields[1]),
                "fstype": fields[2],
                "options": split_options(fields[3]),
            }
        )
    return result


def file_observation(path: Path) -> dict[str, object]:
    try:
        stat = path.stat()
    except OSError:
        return {"exists": False, "size": 0}
    return {"exists": path.is_file(), "size": stat.st_size}


def write_atomic(path: Path, data: dict[str, object]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(
        prefix=f".{path.name}.", dir=path.parent
    )
    temporary_path = Path(temporary)
    try:
        os.fchmod(descriptor, 0o644)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_path, path)
    except Exception:
        temporary_path.unlink(missing_ok=True)
        raise


def emit_serial(data: dict[str, object]) -> bool:
    line = "FELUNYX_INSTALLED=" + json.dumps(data, sort_keys=True)
    for target in ("/dev/ttyS0", "/dev/console"):
        try:
            with open(target, "w", encoding="utf-8") as handle:
                handle.write(line + "\n")
            return True
        except OSError:
            continue
    return False


def main() -> int:
    if not enabled() or LIVE_MARKER.exists():
        return 0

    build_metadata, build_info = read_build_info()
    os_release = read_os_release()
    kernel = subprocess.check_output(["uname", "-r"], text=True).strip()
    kernel_variant = (
        "lts" if "lts" in kernel else "zen" if "zen" in kernel else "unknown"
    )

    data: dict[str, object] = {
        "schema": 1,
        "id": os_release.get("ID"),
        "build_metadata": build_metadata,
        "build_info": build_info,
        "kernel": kernel,
        "kernel_variant": kernel_variant,
        "live": False,
        "uefi": Path("/sys/firmware/efi").is_dir(),
        "packages": {
            "grub": package_present("grub"),
            "linux-zen": package_present("linux-zen"),
            "linux-lts": package_present("linux-lts"),
            "felunyx-iso-hooks": package_present("felunyx-iso-hooks"),
        },
        "files": {
            "grub_cfg": file_observation(Path("/boot/grub/grub.cfg")),
            "linux_zen_kernel": file_observation(Path("/boot/vmlinuz-linux-zen")),
            "linux_lts_kernel": file_observation(Path("/boot/vmlinuz-linux-lts")),
            "live_marker": LIVE_MARKER.exists(),
            "live_sudo": Path("/etc/sudoers.d/10-felunyx-live").exists(),
            "live_autologin": Path(
                "/etc/sddm.conf.d/10-felunyx-live.conf"
            ).exists(),
        },
        "services": {
            "sddm_active": active("sddm.service"),
            "networkmanager_active": active("NetworkManager.service"),
            "sshd_service_active": active("sshd.service"),
            "sshd_socket_active": active("sshd.socket"),
        },
        "mounts": {target: find_mount(target) for target in EXPECTED_TARGETS},
        "subvolumes": btrfs_subvolumes(),
        "fstab": read_fstab(),
    }

    write_atomic(OUTPUT, data)
    return 0 if emit_serial(data) else 1


if __name__ == "__main__":
    raise SystemExit(main())
