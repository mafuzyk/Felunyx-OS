pkgname=calamares
pkgver=3.3.14
pkgrel=1
pkgdesc='Distribution-independent installer framework, Felunyx build'
arch=('x86_64')
url='https://calamares.io/'
license=('GPL-3.0-or-later')
depends=('boost-libs' 'kconfig' 'kcoreaddons' 'kcrash' 'ki18n' 'kio' 'kparts' 'kpmcore' 'kservice' 'kwidgetsaddons' 'libpwquality' 'polkit-qt6' 'python' 'python-yaml' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'squashfs-tools' 'yaml-cpp')
makedepends=('boost' 'cmake' 'extra-cmake-modules' 'ninja')
source=("https://github.com/calamares/calamares/releases/download/v${pkgver}/calamares-${pkgver}.tar.gz"
        "https://github.com/calamares/calamares/releases/download/v${pkgver}/calamares-${pkgver}.tar.gz.sig")
sha256sums=('5547f80db067dea923ae693ba6bb88eb2b2eeac1da3ebec42fce453e31c290c0'
            'SKIP')
validpgpkeys=('6D98B995A1CA6CE4BB906518C7AA337DFA13881E')

build() {
  cmake -S "calamares-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DINSTALL_CONFIG=OFF \
    -DBUILD_TESTING=OFF \
    -DWITH_QT6=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
